<odoo>

    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="menu_school_root"
              name="School SPS"
              sequence="1"/>

    <menuitem id="menu_student"
              name="Students"
              parent="menu_school_root"
              action="action_student"
              sequence="2"/>

    <record id="student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">

            <form>

                <header>
                    <button name="action_confirm" type="object" string="Confirm"/>
                    <button name="action_cancel" type="object" string="Cancel"/>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>

                    <notebook>

                        <page string="Basic Info">
                            <group>
                                <field name="admission_no"/>
                                <field name="admission_date"/>
                                <field name="first_name"/>
                                <field name="last_name"/>
                                <field name="phone"/>
                                <field name="class_id"/>
                            </group>
                        </page>

                        <page string="Family">
                            <group>
                                <field name="father_name"/>
                                <field name="mother_name"/>
                            </group>
                        </page>

                        <page string="Remarks">
                            <field name="remarks_ids">
                                <list editable="bottom">
                                    <field name="remark"/>
                                    <field name="teacher_id"/>
                                    <field name="date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Attendance">
                            <field name="attendance_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="status"/>
                                    <field name="teacher_id"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>
            </form>

        </field>
    </record>

    <record id="student_list" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="admission_no"/>
                <field name="name"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

</odoo>