<odoo>

    <record id="view_fees_list" model="ir.ui.view">
        <field name="name">fees.list</field>
        <field name="model">school.fees</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_fees_form" model="ir.ui.view">
        <field name="name">fees.form</field>
        <field name="model">school.fees</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="amount"/>
                        <field name="date"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fees" model="ir.actions.act_window">
        <field name="name">Fees</field>
        <field name="res_model">school.fees</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>