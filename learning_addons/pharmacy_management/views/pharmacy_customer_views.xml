<odoo>

    <record id="action_pharmacy_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">pharmacy.customer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pharmacy_customer_list" model="ir.ui.view">
        <field name="name">pharmacy.customer.list</field>
        <field name="model">pharmacy.customer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_customer_form" model="ir.ui.view">
        <field name="name">pharmacy.customer.form</field>
        <field name="model">pharmacy.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

