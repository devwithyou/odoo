<odoo>

    <!-- DASHBOARD VIEW -->
    <record id="view_pharmacy_dashboard_form" model="ir.ui.view">
        <field name="name">pharmacy.dashboard.form</field>
        <field name="model">pharmacy.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard">
                <sheet>

                    <h1>Pharmacy Dashboard</h1>

                    <group col="4">

                        <group string="Medicines">
                            <field name="total_medicines" readonly="1"/>
                        </group>

                        <group string="Customers">
                            <field name="total_customers" readonly="1"/>
                        </group>

                        <group string="Sales">
                            <field name="total_sales" readonly="1"/>
                        </group>

                        <group string="Revenue">
                            <field name="total_revenue" readonly="1"/>
                        </group>

                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- SERVER ACTION (NEW ID = FIX) -->
    <record id="action_pharmacy_dashboard_server" model="ir.actions.server">
        <field name="name">Dashboard</field>
        <field name="model_id" ref="model_pharmacy_dashboard"/>
        <field name="state">code</field>
        <field name="code">
action = env['pharmacy.dashboard'].open_dashboard()
        </field>
    </record>

</odoo>