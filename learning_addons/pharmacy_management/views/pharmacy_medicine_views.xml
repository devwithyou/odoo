<odoo>

    <record id="action_pharmacy_medicine" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">pharmacy.medicine</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pharmacy_medicine_list" model="ir.ui.view">
        <field name="name">pharmacy.medicine.list</field>
        <field name="model">pharmacy.medicine</field>
        <field name="arch" type="xml">
            <list>
                <field name="default_code"/>
                <field name="name"/>
                <field name="manufacturer"/>
                <field name="sale_price"/>
                <field name="available_qty"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_medicine_form" model="ir.ui.view">
        <field name="name">pharmacy.medicine.form</field>
        <field name="model">pharmacy.medicine</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="default_code"/>
                        <field name="name"/>
                        <field name="manufacturer"/>
                        <field name="sale_price"/>
                        <field name="cost_price"/>
                        <field name="available_qty" readonly="1"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Batches">
                            <field name="batch_ids">
                                <list editable="bottom">
                                    <field name="batch_no"/>
                                    <field name="expiry_date"/>
                                    <field name="quantity"/>
                                    <field name="purchase_price"/>
                                    <field name="supplier"/>
                                    <field name="is_expired" readonly="1"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

