<odoo>

    <record id="action_pharmacy_batch" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">pharmacy.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pharmacy_batch_list" model="ir.ui.view">
        <field name="name">pharmacy.batch.list</field>
        <field name="model">pharmacy.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="medicine_id"/>
                <field name="batch_no"/>
                <field name="expiry_date"/>
                <field name="is_expired"/>
                <field name="quantity"/>
                <field name="purchase_price"/>
                <field name="supplier"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_batch_form" model="ir.ui.view">
        <field name="name">pharmacy.batch.form</field>
        <field name="model">pharmacy.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="medicine_id"/>
                        <field name="batch_no"/>
                        <field name="expiry_date"/>
                        <field name="is_expired" readonly="1"/>
                        <field name="quantity"/>
                        <field name="purchase_price"/>
                        <field name="supplier"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

